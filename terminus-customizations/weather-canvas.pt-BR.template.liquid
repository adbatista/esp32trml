{% comment %} pt-BR translations (local) {% endcomment %}
{% assign pt_day_1 = source_1.day_1_name %}{% case source_1.day_1_name %}{% when "Mon" %}{% assign pt_day_1 = "Seg" %}{% when "Tue" %}{% assign pt_day_1 = "Ter" %}{% when "Wed" %}{% assign pt_day_1 = "Qua" %}{% when "Thu" %}{% assign pt_day_1 = "Qui" %}{% when "Fri" %}{% assign pt_day_1 = "Sex" %}{% when "Sat" %}{% assign pt_day_1 = "Sáb" %}{% when "Sun" %}{% assign pt_day_1 = "Dom" %}{% endcase %}
{% assign pt_day_2 = source_1.day_2_name %}{% case source_1.day_2_name %}{% when "Mon" %}{% assign pt_day_2 = "Seg" %}{% when "Tue" %}{% assign pt_day_2 = "Ter" %}{% when "Wed" %}{% assign pt_day_2 = "Qua" %}{% when "Thu" %}{% assign pt_day_2 = "Qui" %}{% when "Fri" %}{% assign pt_day_2 = "Sex" %}{% when "Sat" %}{% assign pt_day_2 = "Sáb" %}{% when "Sun" %}{% assign pt_day_2 = "Dom" %}{% endcase %}
{% assign pt_day_3 = source_1.day_3_name %}{% case source_1.day_3_name %}{% when "Mon" %}{% assign pt_day_3 = "Seg" %}{% when "Tue" %}{% assign pt_day_3 = "Ter" %}{% when "Wed" %}{% assign pt_day_3 = "Qua" %}{% when "Thu" %}{% assign pt_day_3 = "Qui" %}{% when "Fri" %}{% assign pt_day_3 = "Sex" %}{% when "Sat" %}{% assign pt_day_3 = "Sáb" %}{% when "Sun" %}{% assign pt_day_3 = "Dom" %}{% endcase %}
{% assign pt_desc = source_1.description %}{% case source_1.description %}{% when "Clear" %}{% assign pt_desc = "Céu limpo" %}{% when "Clear Sky" %}{% assign pt_desc = "Céu limpo" %}{% when "Sunny" %}{% assign pt_desc = "Ensolarado" %}{% when "Mainly Clear" %}{% assign pt_desc = "Quase limpo" %}{% when "Mostly Clear" %}{% assign pt_desc = "Quase limpo" %}{% when "Partly Cloudy" %}{% assign pt_desc = "Parcialmente nublado" %}{% when "Cloudy" %}{% assign pt_desc = "Nublado" %}{% when "Overcast" %}{% assign pt_desc = "Encoberto" %}{% when "Fog" %}{% assign pt_desc = "Neblina" %}{% when "Foggy" %}{% assign pt_desc = "Neblina" %}{% when "Mist" %}{% assign pt_desc = "Névoa" %}{% when "Drizzle" %}{% assign pt_desc = "Garoa" %}{% when "Light Drizzle" %}{% assign pt_desc = "Garoa fraca" %}{% when "Rain" %}{% assign pt_desc = "Chuva" %}{% when "Light Rain" %}{% assign pt_desc = "Chuva fraca" %}{% when "Moderate Rain" %}{% assign pt_desc = "Chuva moderada" %}{% when "Heavy Rain" %}{% assign pt_desc = "Chuva forte" %}{% when "Showers" %}{% assign pt_desc = "Pancadas de chuva" %}{% when "Rain Showers" %}{% assign pt_desc = "Pancadas de chuva" %}{% when "Light Showers" %}{% assign pt_desc = "Pancadas fracas" %}{% when "Heavy Showers" %}{% assign pt_desc = "Pancadas fortes" %}{% when "Freezing Rain" %}{% assign pt_desc = "Chuva congelante" %}{% when "Snow" %}{% assign pt_desc = "Neve" %}{% when "Light Snow" %}{% assign pt_desc = "Neve fraca" %}{% when "Heavy Snow" %}{% assign pt_desc = "Neve forte" %}{% when "Snow Showers" %}{% assign pt_desc = "Pancadas de neve" %}{% when "Thunderstorm" %}{% assign pt_desc = "Tempestade" %}{% when "Thunderstorms" %}{% assign pt_desc = "Tempestades" %}{% when "Hail" %}{% assign pt_desc = "Granizo" %}{% when "Windy" %}{% assign pt_desc = "Ventania" %}{% endcase %}
{% assign pt_time = source_1.update_time | date: "%H:%M" | default: source_1.update_time %}
<div class="{{ extension.css_classes }}">
  <div class="view view--full">
    <style>
  /* 1. OG Landscape (Default - 800x480) */
  .canvas-wrapper {
    --f-huge: 700 76px/1.0 'Inter', sans-serif;
    --f-header: 700 1.5rem/1.1 'Inter', sans-serif;
    --f-desc: italic 500 1.2rem/1.2 'Inter', sans-serif;
    --f-val: 800 1.2rem/1.1 'Inter', sans-serif;
    --f-lbl: 500 0.9rem/1.1 'Inter', sans-serif;
    
    --f-fc-title: 700 0.9rem/1.1 'Inter', sans-serif;
    --f-fc-val: 800 1.0rem/1.1 'Inter', sans-serif;
    --fc-pad: 5px solid transparent;
    
    --canvas-cols: 50% 50%;
    --canvas-rows: 100%;
    --panel-border: 4px solid #000;
    --panel-pad: 8px 15px 10px 15px;
    
    --gap-main: 6px;
    --icon-size: 38px;
    --main-ico-max: 110px;
    --forecast-ico: 40px;
  }

  /* 2. TRMNL X Landscape (1200x825) */
  .screen--lg .canvas-wrapper,
  .screen--v2 .canvas-wrapper,
  .screen--x .canvas-wrapper {
    --f-huge: 700 100px/1.0 'Inter', sans-serif;
    --f-header: 700 2.2rem/1.1 'Inter', sans-serif;
    --f-desc: italic 500 1.6rem/1.3 'Inter', sans-serif;
    --f-val: 800 1.5rem/1.2 'Inter', sans-serif;
    --f-lbl: 500 1.05rem/1.3 'Inter', sans-serif;
    
    --f-fc-title: 700 1.2rem/1.2 'Inter', sans-serif;
    --f-fc-val: 800 1.3rem/1.2 'Inter', sans-serif;
    --fc-pad: 8px solid transparent;
    
    --canvas-cols: 50% 50%;
    --canvas-rows: 100%;
    --panel-border: 4px solid #000;
    --panel-pad: 20px 30px 18px 30px;
    
    --gap-main: 14px;
    --icon-size: 55px;
    --main-ico-max: 205px;
    --forecast-ico: 65px;
  }

  @media (min-width: 801px) {
    .canvas-wrapper {
      --f-huge: 700 100px/1.0 'Inter', sans-serif;
      --f-header: 700 2.2rem/1.1 'Inter', sans-serif;
      --f-desc: italic 500 1.6rem/1.3 'Inter', sans-serif;
      --f-val: 800 1.5rem/1.2 'Inter', sans-serif;
      --f-lbl: 500 1.05rem/1.3 'Inter', sans-serif;
      
      --f-fc-title: 700 1.2rem/1.2 'Inter', sans-serif;
      --f-fc-val: 800 1.3rem/1.2 'Inter', sans-serif;
      --fc-pad: 8px solid transparent;
      
      --canvas-cols: 50% 50%;
      --canvas-rows: 100%;
      --panel-border: 4px solid #000;
      --panel-pad: 20px 30px 18px 30px;
      
      --gap-main: 14px;
      --icon-size: 55px;
      --main-ico-max: 205px;
      --forecast-ico: 65px;
    }
  }

  /* 3. OG Portrait (480x800) */
  .screen--portrait .canvas-wrapper {
    --canvas-cols: 100%;
    --canvas-rows: auto 1fr;
    --panel-border: none;
    --panel-pad: 12px 15px;
    
    --f-huge: 700 42px/1.0 'Inter', sans-serif;
    --f-header: 700 1.4rem/1.1 'Inter', sans-serif;
    --f-desc: italic 500 1.1rem/1.2 'Inter', sans-serif;
    --f-val: 800 0.7rem/1.1 'Inter', sans-serif;
    --f-lbl: 500 0.75rem/1.1 'Inter', sans-serif;
    
    --f-fc-title: 700 0.85rem/1.1 'Inter', sans-serif;
    --f-fc-val: 800 0.95rem/1.1 'Inter', sans-serif;
    --fc-pad: 4px solid transparent;
    
    --icon-size: 26px;
    --main-ico-max: 65px;
    --forecast-ico: 28px;
    --gap-main: 8px;
  }

  /* 4. TRMNL X Portrait (825x1200) */
  .screen--portrait.screen--lg .canvas-wrapper,
  .screen--portrait.screen--v2 .canvas-wrapper,
  .screen--portrait.screen--x .canvas-wrapper {
    --canvas-cols: 100%;
    --canvas-rows: auto 1fr;
    --panel-border: none;
    --panel-pad: 20px 25px;
    
    --f-huge: 700 75px/1.0 'Inter', sans-serif;
    --f-header: 700 1.8rem/1.1 'Inter', sans-serif;
    --f-desc: italic 500 1.4rem/1.2 'Inter', sans-serif;
    --f-val: 800 1.25rem/1.1 'Inter', sans-serif;
    --f-lbl: 500 0.95rem/1.1 'Inter', sans-serif;
    
    --f-fc-title: 700 1.1rem/1.1 'Inter', sans-serif;
    --f-fc-val: 800 1.2rem/1.1 'Inter', sans-serif;
    --fc-pad: 6px solid transparent;
    
    --icon-size: 42px;
    --main-ico-max: 110px;
    --forecast-ico: 44px;
    --gap-main: 14px;
  }

  @media (min-width: 481px) {
    .screen--portrait .canvas-wrapper {
      --canvas-cols: 100%;
      --canvas-rows: auto 1fr;
      --panel-border: none;
      --panel-pad: 20px 25px;
      
      --f-huge: 700 75px/1.0 'Inter', sans-serif;
      --f-header: 700 1.8rem/1.1 'Inter', sans-serif;
      --f-desc: italic 500 1.4rem/1.2 'Inter', sans-serif;
      --f-val: 800 1.25rem/1.1 'Inter', sans-serif;
      --f-lbl: 500 0.95rem/1.1 'Inter', sans-serif;
      
      --f-fc-title: 700 1.1rem/1.1 'Inter', sans-serif;
      --f-fc-val: 800 1.2rem/1.1 'Inter', sans-serif;
      --fc-pad: 6px solid transparent;
      
      --icon-size: 42px;
      --main-ico-max: 110px;
      --forecast-ico: 44px;
      --gap-main: 14px;
    }
  }

  /* Layout & Grid */
  .canvas-wrapper, .canvas-wrapper * {
    font-family: 'Inter', system-ui, sans-serif !important;
    box-sizing: border-box;
  }

  .canvas-wrapper {
    display: grid;
    grid-template-columns: var(--canvas-cols);
    grid-template-rows: var(--canvas-rows);
    width: 100%;
    height: calc(100vh - 44px);
    overflow: hidden;
  }

  .left-panel, .right-panel { min-width: 0; min-height: 0; }

  .left-panel {
    display: flex;
    flex-direction: column;
    border-right: var(--panel-border);
    padding: var(--panel-pad);
  }

  .screen--portrait .left-panel { border-bottom: 4px solid #000; }

  .top-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    gap: var(--gap-main);
  }

  .data-left { display: flex; flex-direction: column; gap: var(--gap-main); }
  .data-right { display: flex; flex-direction: column; flex-grow: 1; min-height: 0; gap: var(--gap-main); }
  .portrait-divider { display: none; }

  .screen--portrait .top-content {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 15px;
  }
  .screen--portrait .portrait-divider {
    display: block;
    width: 2px;
    background: #000;
  }

  .location-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .location-header .title { font: var(--f-header) !important; color: #000; }
  .location-icon { width: 28px; height: 28px; flex-shrink: 0; }

  /* Altijd exact 50% / 50% zodat de grijze lijn in het midden staat */
  .current-weather-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    width: 100%;
  }

  .temp-column {
    min-width: 0;
    max-width: 100%;
    border-right: 12px solid transparent;
  }

  .temp-huge {
    font: var(--f-huge);
    letter-spacing: -2px;
    display: block;
    white-space: nowrap;
  }

  .weather-description {
    font: var(--f-desc);
    color: #000;
  }

  .stats-col-wrapper { border-left: 3px solid #888888; display: flex; }
  .stats-column {
    border-left: 10px solid transparent;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-item { display: flex; align-items: center; gap: 8px; }
  .stat-icon { width: var(--icon-size); height: var(--icon-size); flex-shrink: 0; }
  .stat-content { display: flex; flex-direction: column; white-space: nowrap; }
  .stat-content .value { font: var(--f-val) !important; color: #000; }
  .stat-content .label { font: var(--f-lbl) !important; color: #555; }

  .main-icon-container {
    display: flex;
    align-items: center;
    place-content: center;
    width: 100%;
    flex-grow: 1;
    min-height: 0;
  }

  .main-weather-icon {
    width: 85%;
    max-height: var(--main-ico-max);
    object-fit: contain;
  }

  .forecast-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    flex-shrink: 0;
    gap: var(--gap-main);
  }

  .custom-divider {
    width: 100%;
    height: 2px;
    background: #000;
    flex-shrink: 0;
  }

  .forecast-grid { gap: var(--gap-main) !important; width: 100%; }

  .fc-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-top: var(--fc-pad);
    border-bottom: var(--fc-pad);
    gap: 4px;
  }

  .fc-col .label { font: var(--f-fc-title) !important; color: #000; }
  .fc-col .value { font: var(--f-fc-val) !important; color: #000; }

  .weather-icon-large { width: var(--forecast-ico) !important; }

  .right-panel {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .screen--portrait .right-panel { align-items: flex-end; }

  .art-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .screen--portrait .art-image {
    object-fit: contain;
    object-position: bottom;
  }
</style>
<div class="canvas-wrapper">
  <div class="left-panel">
    <div class="top-content">
      <div class="data-left">
        <div class="location-header">
          <span class="title">
            {{ source_1.location_name }}
          </span>
          <svg class="location-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div class="current-weather-row">
          <div class="temp-column">
            <span class="temp-huge" data-fit-value="true">
              {{ source_1.current_temp }}&deg;</span>
          </div>
          <div class="stats-col-wrapper">
            <div class="stats-column">
              <div class="stat-item">
                <img class="stat-icon" src="https://usetrmnl.com/images/plugins/weather/wi-thermometer.svg">
                <div class="stat-content">
                  <span class="value">
                    {{ source_1.max_temp }}&deg; / {{ source_1.min_temp }}&deg;</span>
                  <span class="label">
                    Máx / Mín
                  </span>
                </div>
              </div>
              <div class="stat-item">
                <img class="stat-icon" src="https://usetrmnl.com/images/plugins/weather/wi-umbrella.svg">
                <div class="stat-content">
                  <span class="value">
                    {{ source_1.rain_chance }}%
                  </span>
                  <span class="label">
                    Chance de chuva
                  </span>
                </div>
              </div>
              <div class="stat-item">
                <img class="stat-icon" src="https://usetrmnl.com/images/plugins/weather/wi-hot.svg">
                <div class="stat-content">
                  <span class="value">
                    {{ source_1.uv_index }}
                  </span>
                  <span class="label">
                    Índice UV
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="portrait-divider"></div>
      <div class="data-right">
        <div class="weather-description">
          {{ pt_desc }}
        </div>
        <div class="main-icon-container">
          <img class="main-weather-icon" src="{{ source_1.current_icon_url }}">
        </div>
        <div class="forecast-wrapper">
          <div class="custom-divider"></div>
          <div class="grid grid--cols-3 forecast-grid">
            <div class="col fc-col bg--gray-65 2bit:bg--gray-55 rounded--small">
              <span class="label">
                {{ pt_day_1 }}
              </span>
              <img class="weather-icon-large image-stroke" src="{{ source_1.day_1_icon_url }}">
              <span class="value text-stroke">
                {{ source_1.day_1_temp }}&deg;</span>
            </div>
            <div class="col fc-col bg--gray-65 2bit:bg--gray-55 rounded--small">
              <span class="label">
                {{ pt_day_2 }}
              </span>
              <img class="weather-icon-large image-stroke" src="{{ source_1.day_2_icon_url }}">
              <span class="value text-stroke">
                {{ source_1.day_2_temp }}&deg;</span>
            </div>
            <div class="col fc-col bg--gray-65 2bit:bg--gray-55 rounded--small">
              <span class="label">
                {{ pt_day_3 }}
              </span>
              <img class="weather-icon-large image-stroke" src="{{ source_1.day_3_icon_url }}">
              <span class="value text-stroke">
                {{ source_1.day_3_temp }}&deg;</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="right-panel">
    <img class="art-image" src="{{ source_1.illustration_url }}">
  </div>
</div>
<div class="title_bar">
  <img class="image" src="https://usetrmnl.com/images/plugins/weather--render.svg">
  <span class="title">Weather Canvas</span>
  <span class="instance">
    Atualizado: 
    {{ pt_time }}
  </span>
</div>
  </div>
</div>

